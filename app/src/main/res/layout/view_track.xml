<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_track"
    android:layout_width="match_parent"
    android:layout_height="@dimen/track_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/margin_40">

        <ImageView
            android:id="@+id/image_place_holder"
            android:layout_marginStart="@dimen/margin_start_track"
            android:layout_marginTop="@dimen/image_margin"
            android:layout_marginEnd="@dimen/image_margin"
            android:layout_width="@dimen/image_h_w"
            android:layout_height="@dimen/image_h_w"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_14"
            android:orientation="vertical">

            <TextView
                android:id="@+id/track_name"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Ters-0er3tr20r-0wfkie-0-=23rwefw;;23r30fsdfssdfsdfds"
                android:textSize="@dimen/big_text_list" />

            <LinearLayout
                android:showDividers="middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@drawable/ellipse"
                android:orientation="horizontal"
               >

                <TextView

                    android:id="@+id/musician"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:textColor="@color/grayView"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:textSize="@dimen/small_text_list"
                    tools:text="Deferwfwfe;32e325435.43543t4rogifeg5kt435edfwedwddf" />

                <TextView
                    android:id="@+id/time_place_holder"
                    android:textColor="@color/grayView"
                    tools:text="6:30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text_list" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/image_forward_arrow"
        android:layout_height="wrap_content"
        android:layout_gravity="center|end"
        android:layout_width="wrap_content"
        android:src="@drawable/vectorsetting3"
        android:layout_marginEnd="@dimen/margin_image_track"
        app:tint="@color/grayView" />

</FrameLayout>