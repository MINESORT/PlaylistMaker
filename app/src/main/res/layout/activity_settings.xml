<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/Text_BlackAndWhite"
   >

    <LinearLayout
        android:background="@color/Text_BlackAndWhite"
        android:layout_width="match_parent"
        android:layout_height="@dimen/Top_Padding"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/Main_text_marginTop"
        >
        <Button
            style="@style/backButton"
            android:id= "@+id/backSettings"
            app:icon="@drawable/vectormainsettings" />
        <TextView
            style="@style/headlineOther"
            android:text="@string/Settings" />
    </LinearLayout>


    <LinearLayout
        android:background="@color/Text_BlackAndWhite"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/Main_layout_marginTop"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/Corner_Radius"
        >

        <Switch
            style="@style/SettingsBase"
            android:layout_marginEnd="10dp"
            android:paddingEnd="-3dp"
            android:id="@+id/switch6"
            android:text="@string/User_Black_Theme"
            tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml" />

        <TextView
            style="@style/SettingsButton"
            android:id="@+id/ShareButton"
            android:paddingEnd="2dp"
            android:drawableEnd="@drawable/vectorsetting1"
            android:text="@string/User_Share" />
        <TextView
            android:paddingEnd="0dp"
            style="@style/SettingsButton"
            android:id="@+id/SupportService"
            android:drawableEnd="@drawable/groupsettin2"
            android:text=   "@string/User_Support" />
        <TextView
            style="@style/SettingsButton"
            android:id="@+id/terms_button"
            android:paddingEnd="6dp"
            android:drawableEnd="@drawable/vectorsetting3"
            android:text="@string/User_Enter" />

        <FrameLayout
            android:background="@color/Text_BlackAndWhite"
            android:layout_marginEnd="@dimen/Main_text_marginTop"
            android:layout_width="match_parent"
            android:layout_weight="50"
            android:layout_height="@dimen/empty_layout_height"/>
    </LinearLayout>

</LinearLayout>