<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"

    android:background="@color/Text_BlackAndWhite">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/Top_Padding"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/Main_text_marginTop"
        >
        <Button
            style="@style/backButton"
            android:id= "@+id/backSettings"
            app:icon="@drawable/vectormainsettings"

            />
        <TextView
            style="@style/headlineOther"
            android:text="@string/Search"
          />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_6"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/Corner_Radius"
        android:layout_marginEnd="@dimen/Corner_Radius"
        >

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <EditText
            android:drawableStart="@drawable/vector"
            style="@style/EditTextStyle"
            android:id="@+id/searchWatcher"
            tools:ignore="RtlSymmetry"
            android:imeOptions="actionDone"
            android:singleLine="true"/>

        <ImageView
            android:id="@+id/xIcon"
            android:layout_gravity="end"
            android:paddingEnd="@dimen/padding_image_search_end"
            android:paddingTop="@dimen/padding_image_search_top"
            app:tint="@color/GreySearch"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/x_icon"
            tools:ignore="RtlSymmetry" />
        </FrameLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:paddingTop="@dimen/image_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"/>


        <LinearLayout
            android:id="@+id/history_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                style="@style/searchTextHistory"
                android:text="@string/search"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_rec"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:paddingTop="@dimen/padding_8"
                android:layout_weight="1"/>

            <Button
                style="@style/clearHistory"
                android:id="@+id/delete_history"
                android:text="@string/history_clear"
                 />

        </LinearLayout>




<LinearLayout
    style="@style/errorLayout"
    android:id="@+id/error_not_found"
>
<ImageView
    style="@style/notFindPlaceholder"
     />
<TextView

    style="@style/errorTextView"
    android:text="@string/noToFind"
   />
</LinearLayout>

<LinearLayout
    style="@style/errorLayout"
    android:id="@+id/error_no_internet"
    >
<ImageView
    style="@style/noInternetPlaceholder"
    />
<TextView
    style="@style/errorTextView"
    android:text="@string/connection_lost"
    android:layout_gravity="center"
    />

<TextView
    style="@style/errorTextView"
    android:text="@string/no_internet"
    tools:ignore="HardcodedText" />
<Button
    style="@style/updateButton"
    android:id="@+id/update_button"
    android:text="@string/update"
    />
</LinearLayout>

    <ProgressBar android:id="@+id/progressBar"
        style="@style/progressBarStyle"
        android:indeterminateTint="@color/rt_blue"
        android:visibility="gone"/>

    </LinearLayout>