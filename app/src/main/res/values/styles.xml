<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainActivityButtons" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:fontWeight">@integer/layout_weight_xy</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/Buttons_height</item>
        <item name="backgroundTint">@color/Main_White</item>
        <item name="android:textColor">@color/Nes_Black</item>
        <item name="android:textSize">@dimen/Text_size</item>
        <item name="android:layout_weight">@integer/layout_weight_base</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">@dimen/Corner_Radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/Icon_Padding</item>
        <item name="iconTint">@color/Nes_Black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="SettingsBase" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:paddingStart">0dp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/SettingText_Black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/Settings_Padding</item>
        <item name="android:layout_weight">@integer/layout_weight_base</item>
        <item name="android:textSize">@dimen/Text_size_settings</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical</item>

    </style>

    <style name="SettingsButton" parent="SettingsBase">
        <item name="drawableTint">@color/GreyIcon</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:layout_marginEnd">@dimen/Main_text_marginTop</item>
    </style>

    <style name="backButton">
        <item name="iconTint">@color/SettingText_Black</item>
        <item name="android:layout_marginTop">@dimen/back_button_margin_top</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:layout_marginStart">@dimen/Corner_Radius</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_width">@dimen/general_icon_par</item>
        <item name="android:layout_height">@dimen/general_icon_par</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/Icon_Padding</item>
    </style>

    <style name="headlineMain">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:fontWeight">@integer/layout_weight_xy</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:textSize">@dimen/Text_size</item>

    </style>

    <style name="headlineOther" parent="headlineMain">
        <item name="android:textColor">@color/SettingText_Black</item>
        <item name="android:drawablePadding">@dimen/drawable_padding</item>
        <item name="android:layout_marginStart">@dimen/text_margin_start</item>
    </style>

    <style name="EditTextStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:backgroundTint">@color/EditSearch</item>
        <item name="android:textColorHint">@color/GreySearch</item>
        <item name="android:textColor">@color/Edit_Black</item>
        <item name="android:drawableTint">@color/GreySearch</item>
        <item name="android:paddingStart">@dimen/drawable_padding</item>
        <item name="android:drawablePadding">@dimen/Icon_Padding</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:inputType">text</item>
        <item name="android:hint">@string/Search</item>
        <item name="android:background">@drawable/et_style</item>
        <item name="android:lines">1</item>
        <item name="android:maxLength">15</item>
    </style>


    <style name="TrackHolderTextBig">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/big_text_list</item>
    </style>

    <style name="TrackHolderTextSmall">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/grayView</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">@dimen/small_text_list</item>


    </style>

    <style name="TrackHolderTextTime">
        <item name="android:textColor">@color/grayView</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/small_text_list</item>
    </style>

    <style name="TrackHolderTextImage">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center|end</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:src">@drawable/vectorsetting3</item>
        <item name="android:layout_marginEnd">@dimen/margin_image_track</item>
        <item name="tint">@color/grayView</item>

    </style>

    <style name="TrackHolderTextSquare">
        <item name="android:layout_marginStart">@dimen/margin_start_track</item>
        <item name="android:layout_marginTop">@dimen/image_margin</item>
        <item name="android:layout_marginEnd">@dimen/image_margin</item>
        <item name="android:layout_width">@dimen/image_h_w</item>
        <item name="android:layout_height">@dimen/image_h_w</item>
    </style>

    <style name="notFindPlaceholder">
        <item name="android:src">@drawable/not_find_white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">@dimen/pad_top_110</item>
        <item name="android:layout_gravity">center</item>

    </style>

    <style name="noInternetPlaceholder">
        <item name="android:src">@drawable/no_internet_white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingTop">@dimen/pad_top_110</item>
    </style>

    <style name="errorLayout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="errorTextView">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">@dimen/pad_top_16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_size_19sp</item>

    </style>

    <style name="updateButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/pad_top_16dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:backgroundTint">@color/SettingText_Black</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/rad_54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/size_14</item>

    </style>

    <style name="searchTextHistory">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingTop">@dimen/padding_50</item>
        <item name="android:textColor">@color/tp_black</item>
        <item name="android:textSize">@dimen/text_size_19sp</item>

    </style>

    <style name="clearHistory">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">@dimen/padding_24</item>
        <item name="android:backgroundTint">@color/tp_black</item>
        <item name="android:paddingHorizontal">@dimen/pad_top_16dp</item>
        <item name="android:paddingVertical">@dimen/padding_image_search_top</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tp_white</item>
        <item name="android:textSize">@dimen/size_14</item>
        <item name="cornerRadius">@dimen/rad_54dp</item>

    </style>




    <style name="xBackButton">

        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="tint">@color/tp_black</item>
        <item name="android:src">@drawable/vectormainsettings</item>
    </style>

    <style name="back_player" parent="xBackButton">
        <item name="android:layout_marginTop">@dimen/margin_image_track</item>
        <item name="android:layout_marginStart">@dimen/margin_image_track</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>

    </style>

    <style name="player_text">
        <item name="android:textSize">@dimen/small_text_list</item>
        <item name="android:textColor">@color/tp_black</item>
    </style>


    <style name="player_text2">
